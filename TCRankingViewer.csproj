<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/13.1.0">
  <PropertyGroup>
    <Version>1.1.0.2</Version>
    <Description>自動從 TC 繁中服排名查詢隊友 Savage 排名。</Description>
    <PackageProjectUrl>https://github.com/SamoyedQQ/TCRankingViewer</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ECommons\**" />
    <Content Remove="ECommons\**" />
    <EmbeddedResource Remove="ECommons\**" />
    <None Remove="ECommons\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TCRankingViewer.json" />
    <Content Include="assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>icon.png</TargetPath>
    </Content>
    <!-- 手動放入 assets\jobs\ 的職業 icon 圖檔，打包到輸出 jobs\ 子夾（見 assets\jobs\README.txt） -->
    <Content Include="assets\jobs\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>jobs\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 截圖功能：以 GDI CopyFromScreen 擷取視窗範圍並存成 PNG（Windows-only，遊戲本就 Windows）。
         繁中服 Dalamud 13.x 為 net9.0 執行期，載入的是 System.Drawing.Common 9.0.0；
         ExcludeAssets=runtime 不重複打包，只用其編譯參考、執行期沿用框架提供的版本，避免版本衝突。 -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- API13：ImGui bindings 改由 Dalamud.NET.Sdk 自動引入 Dalamud.Bindings.ImGui，
       不再手動 Reference 舊的 ImGui.NET。 -->
</Project>
